# ── Nmealog environment variables ──────────────────────────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then start the stack:
#   docker compose up -d
#   docker compose -f docker-compose.ghcr.yml up -d   (pre-built images)
#
# Overrides for dev (no Docker):
#   set -a; source .env; set +a        # imports .env into shell safely (handles quoted values)
#   python -m nmealog collector &       # start the collector
#   gunicorn -b 127.0.0.1:8000 "nmealog.web:create_app()"
# ────────────────────────────────────────────────────────────────────────────

# ── Web server ─────────────────────────────────────────────────────────────
# Port on the host that maps to the web UI (default 8090).
# The service listens on 127.0.0.1, so only localhost can reach it directly.
# Put nginx in front if you need to expose it externally.
NMEALOG_WEB_PORT=8090

# ── Authentication ─────────────────────────────────────────────────────────
# First-run: leave these commented out and the web UI will prompt you to
# create an admin account on the first visit.
#
# Pre-configured credentials (uncomment and fill in to skip the setup page):
# NMEALOG_USER=admin
# NMEALOG_PASSWORD_HASH='scrypt:...'
#
# Generate a password hash:
#   docker compose exec web python -m nmealog hash-password
# or without Docker:
#   python -m nmealog hash-password
#
# ⚠  WARNING – skip authentication entirely (for testing only):
# NMEALOG_ALLOW_NO_AUTH=1

# ── Security (when served behind nginx with HTTPS) ─────────────────────────
# NMEALOG_SECURE_COOKIES=1

# ── Proxy ──────────────────────────────────────────────────────────────────
# Set when nginx (or another reverse proxy) sits in front of the web UI.
# This tells Flask to trust the X-Forwarded-* headers.
# NMEALOG_TRUST_PROXY=1

# ── Data directory (host path, optional) ───────────────────────────────────
# By default the compose files use a named volume (nmealog-data).
# If you prefer a bind mount, set this and update volumes in the compose file.
# NMEALOG_DATA_DIR=./data